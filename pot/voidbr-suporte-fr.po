#: usr/local/bin/voidbr-suporte:105
msgid "AVISO:"
msgstr "AVIS :"

#: usr/local/bin/voidbr-suporte:106
msgid "ERRO:"
msgstr "ERREUR :"

#: usr/local/bin/voidbr-suporte:112
msgid "'%s' não instalado"
msgstr "'%s' non installé"

#: usr/local/bin/voidbr-suporte:120
msgid "SUPORTE REMOTO VOIDBR ATIVO"
msgstr "ASSISTANCE À DISTANCE VOIDBR ACTIVE"

#: usr/local/bin/voidbr-suporte:139
msgid "curl não instalado; técnico não foi avisado"
msgstr "curl non installé ; le technicien n’a pas été averti"

#: usr/local/bin/voidbr-suporte:141
msgid "Suporte VoidBR: %s"
msgstr "Support VoidBR : %s"

#: usr/local/bin/voidbr-suporte:144
msgid "técnico avisado automaticamente"
msgstr "technicien averti automatiquement"

#: usr/local/bin/voidbr-suporte:146
msgid "não consegui avisar o técnico; passe o comando acima para ele"
msgstr "je n'ai pas pu prévenir le technicien ; transmettez-lui la commande ci-dessus"

#: usr/local/bin/voidbr-suporte:174
msgid "SUPORTE"
msgstr "SOUTIEN"

#: usr/local/bin/voidbr-suporte:194
msgid "exit = encerrar"
msgstr "exit = quitter"

#: usr/local/bin/voidbr-suporte:221
msgid "Encerrando o suporte"
msgstr "Clôture du support"

#: usr/local/bin/voidbr-suporte:226
msgid "máquina removida da rede do técnico"
msgstr "machine retirée du réseau du technicien"

#: usr/local/bin/voidbr-suporte:248
msgid "ts_authkey não definido em %s"
msgstr "ts_authkey non défini dans %s"

#: usr/local/bin/voidbr-suporte:249
msgid "para PEDIR suporte (usuário): configure o ts_authkey"
msgstr "pour DEMANDER de l'assistance (utilisateur) : configurez le ts_authkey"

#: usr/local/bin/voidbr-suporte:250
msgid "para DAR suporte (técnico):   %s --list | --connect"
msgstr "pour FOURNIR un support (technique) : %s --list | --connect"

#: usr/local/bin/voidbr-suporte:263
msgid "Iniciando suporte remoto"
msgstr "Démarrage de l'assistance à distance"

#: usr/local/bin/voidbr-suporte:264
msgid "subindo conexão (modo userspace, estado só em memória)"
msgstr "montée de la connexion (mode userspace, état uniquement en mémoire)"

#: usr/local/bin/voidbr-suporte:278
msgid "tailscaled não subiu; veja %s"
msgstr "tailscaled ne s'est pas lancé ; voir %s"

#: usr/local/bin/voidbr-suporte:281
msgid "tailscaled não respondeu"
msgstr "tailscaled n'a pas répondu"

#: usr/local/bin/voidbr-suporte:283
msgid "entrando na rede do técnico como %s"
msgstr "entrant dans le réseau du technicien comme %s"

#: usr/local/bin/voidbr-suporte:292
msgid "não consegui conectar; confira a internet e a ts_authkey"
msgstr "je n'ai pas pu me connecter ; vérifiez Internet et la ts_authkey"

#: usr/local/bin/voidbr-suporte:304
msgid "Nome desta máquina para o técnico:"
msgstr "Nom de cette machine pour le technicien :"

#: usr/local/bin/voidbr-suporte:305
msgid "sem IP"
msgstr "sans IP"

#: usr/local/bin/voidbr-suporte:306
msgid "O técnico acessa com:"
msgstr "Le technicien accède avec :"

#: usr/local/bin/voidbr-suporte:310 usr/local/bin/voidbr-suporte:373
msgid "O técnico verá e digitará neste terminal junto com você."
msgstr "Le technicien regardera et tapera sur ce terminal avec vous."

#: usr/local/bin/voidbr-suporte:311 usr/local/bin/voidbr-suporte:374
msgid "Para %sENCERRAR o suporte%s, digite: %sexit%s"
msgstr "Pour %sENCERRAR le support%s, tapez : %sexit%s"

#: usr/local/bin/voidbr-suporte:315
msgid "Pressione Enter para abrir o terminal compartilhado..."
msgstr "Appuyez sur Entrée pour ouvrir le terminal partagé..."

#: usr/local/bin/voidbr-suporte:319
msgid "O técnico usará um terminal próprio nesta máquina."
msgstr "Le technicien utilisera un terminal propre sur cette machine."

#: usr/local/bin/voidbr-suporte:321
msgid "Para %sENCERRAR o suporte%s, pressione %sCtrl+C%s"
msgstr "Pour %sENCERRAR le support%s, appuyez sur %sCtrl+C%s"

#: usr/local/bin/voidbr-suporte:324
msgid "Pressione Enter para ENCERRAR o suporte..."
msgstr "Appuyez sur Entrée pour FERMER le support..."

#: usr/local/bin/voidbr-suporte:366
msgid "Passe para o técnico:"
msgstr "Passe au technicien :"

#: usr/local/bin/voidbr-suporte:370
msgid "não consegui ler o comando de acesso; rode: %s"
msgstr "je n'ai pas pu lire la commande d'accès ; exécutez : %s"

#: usr/local/bin/voidbr-suporte:393
msgid "nenhum técnico configurado em %s (tecnicos_github ou tecnicos_chaves)"
msgstr "aucun technicien configuré dans %s (techniciens_github ou techniciens_clés)"

#: usr/local/bin/voidbr-suporte:396
msgid "Iniciando suporte remoto (upterm)"
msgstr "Démarrage du support à distance (upterm)"

#: usr/local/bin/voidbr-suporte:397
msgid "conectando em %s..."
msgstr "connexion à %s..."

#: usr/local/bin/voidbr-suporte:420 usr/local/bin/voidbr-suporte:437
msgid "nenhuma máquina de suporte online"
msgstr "aucune machine de support en ligne"

#: usr/local/bin/voidbr-suporte:423
msgid "IP"
msgstr "IP"

#: usr/local/bin/voidbr-suporte:423
msgid "USUÁRIO"
msgstr "UTILISATEUR"

#: usr/local/bin/voidbr-suporte:424
msgid "NOME"
msgstr "NOM"

#: usr/local/bin/voidbr-suporte:424
msgid "ESTADO"
msgstr "ÉTAT"

#: usr/local/bin/voidbr-suporte:453
msgid "nenhuma máquina de suporte corresponde a '%s'"
msgstr "aucune machine de support ne correspond à '%s'"

#: usr/local/bin/voidbr-suporte:455
msgid "mais de uma máquina corresponde; informe o nome ou o IP"
msgstr "mais d'une machine correspond ; indiquez le nom ou l'IP"

#: usr/local/bin/voidbr-suporte:461
msgid "não sei o usuário de %s; use: %s --connect %s <usuario>"
msgstr "je ne connais pas l'utilisateur de %s ; utilisez : %s --connect %s <utilisateur>"

#: usr/local/bin/voidbr-suporte:464
msgid "Entrando em %s (%s)"
msgstr "Entrant dans %s (%s)"

#: usr/local/bin/voidbr-suporte:486
msgid "não consegui entrar como '%s' em %s (código %s)"
msgstr "je n'ai pas pu me connecter en tant que '%s' dans %s (code %s)"

#: usr/local/bin/voidbr-suporte:488
msgid "a conexão ou o login foi recusado"
msgstr "la connexion ou la connexion a été refusée"

#: usr/local/bin/voidbr-suporte:490
msgid "entrou, mas a sessão '%s' do tmux não abriu (no sessions?)"
msgstr "est entré, mais la session '%s' de tmux ne s'est pas ouverte (pas de sessions ?)"

#: usr/local/bin/voidbr-suporte:492
msgid ""
"o remoto pode estar com versão antiga do voidbr-suporte, ou o usuário é outro"
msgstr "le distant peut avoir une version ancienne de voidbr-support, ou l'utilisateur est un autre"

#: usr/local/bin/voidbr-suporte:493
msgid "tente: %s --connect %s <usuario>"
msgstr "tente : %s --connect %s <usuario>"

#: usr/local/bin/voidbr-suporte:498
msgid "defina ntfy_topico em %s"
msgstr "définir ntfy_topico dans %s"

#: usr/local/bin/voidbr-suporte:500
msgid "Aguardando chamados em %s (Ctrl+C para sair)"
msgstr "En attente d'appels sur %s (Ctrl+C pour quitter)"

#: usr/local/bin/voidbr-suporte:503
msgid "novo chamado:"
msgstr "nouvel appel :"

#: usr/local/bin/voidbr-suporte:509
msgid "uso:"
msgstr "usage :"

#: usr/local/bin/voidbr-suporte:509
msgid "[opções]"
msgstr "[options]"

#: usr/local/bin/voidbr-suporte:511
msgid "Usuário (pedir suporte):"
msgstr "Utilisateur (demander de l'assistance) :"

#: usr/local/bin/voidbr-suporte:512
msgid "(sem opções)"
msgstr "(sans options)"

#: usr/local/bin/voidbr-suporte:512
msgid "inicia o suporte (modo do .conf: %s)"
msgstr "démarre le support (mode du .conf : %s)"

#: usr/local/bin/voidbr-suporte:513
msgid "força o modo Tailscale"
msgstr "force le mode Tailscale"

#: usr/local/bin/voidbr-suporte:514
msgid "força o modo upterm"
msgstr "force le mode upterm"

#: usr/local/bin/voidbr-suporte:516
msgid "Técnico (dar suporte):"
msgstr "Technicien (assistance) :"

#: usr/local/bin/voidbr-suporte:517
msgid "máquinas aguardando suporte"
msgstr "machines en attente de support"

#: usr/local/bin/voidbr-suporte:518
msgid "[alvo] [usuario]"
msgstr "[cible] [utilisateur]"

#: usr/local/bin/voidbr-suporte:518
msgid "conecta na máquina (nome, parte do nome ou IP)"
msgstr "connecte à la machine (nom, partie du nom ou IP)"

#: usr/local/bin/voidbr-suporte:519
msgid "aguarda chamados via ntfy"
msgstr "attend les appels via ntfy"

#: usr/local/bin/voidbr-suporte:521
msgid "Gerais:"
msgstr "Généraux :"

#: usr/local/bin/voidbr-suporte:522
msgid "mostra esta ajuda"
msgstr "montre cette aide"

#: usr/local/bin/voidbr-suporte:523
msgid "mostra a versão"
msgstr "afficher la version"

#: usr/local/bin/voidbr-suporte:525
msgid "Exemplos:"
msgstr "Exemples :"

#: usr/local/bin/voidbr-suporte:526
msgid "usuário pede suporte"
msgstr "l'utilisateur demande de l'assistance"

#: usr/local/bin/voidbr-suporte:527
msgid "técnico vê quem está aguardando"
msgstr "le technicien voit qui attend"

#: usr/local/bin/voidbr-suporte:528
msgid "conecta (se houver só uma máquina)"
msgstr "connecte (s'il n'y a qu'une seule machine)"

#: usr/local/bin/voidbr-suporte:529
msgid "conecta pelo IP"
msgstr "se connecte par IP"

#: usr/local/bin/voidbr-suporte:531
msgid "Configuração:"
msgstr "Configuration :"

#: usr/local/bin/voidbr-suporte:538
msgid "modo inválido em %s: %s"
msgstr "mode invalide dans %s : %s"

#: usr/local/bin/voidbr-suporte:555
msgid "opção inválida: %s"
msgstr "option invalide : %s"

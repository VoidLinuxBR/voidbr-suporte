#!/usr/bin/env bash
# Maintainer  : Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=voidbr-suporte
pkgdesc="Suporte remoto rápido estilo tmate (Tailscale SSH + tmux compartilhado, ou upterm)"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=("$pkgname")
replaces=()
conflicts=()
arch=('any')
license=('MIT')
homepage="https://github.com/voidlinuxbr/$pkgname"
url="https://github.com/voidlinuxbr/$pkgname"
source=("git+${url}.git")
checksum=('SKIP')
makedepends=()
depends=(
	bash
	coreutils
	tailscale
	tmux
	curl
	qrencode
)
# preserva o .conf do usuário (com o ts_authkey) nas atualizações
backup=(/etc/voidbr-suporte.conf)

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	else
		InternalDir="${srcdir}/${pkgname}"
	fi

	cd "${srcdir}/${pkgname}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("etc" "opt" "usr")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# garante permissões do script e do .conf
	chmod 755 "${pkgdir}/usr/bin/voidbr-suporte"
	chmod 644 "${pkgdir}/etc/voidbr-suporte.conf"

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	if grep -q 'tskey-client-XXXX' /etc/voidbr-suporte.conf 2>/dev/null; then
		log "ATENÇÃO: defina ts_authkey em /etc/voidbr-suporte.conf antes de usar o modo tailscale"
	fi
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}

#!/usr/bin/env bash
#
# voidbr-suporte - suporte remoto rápido estilo tmate
#
# Dois modos (escolha em /etc/voidbr-suporte.conf ou na linha de comando):
#   tailscale  máquina entra na sua tailnet como nó efêmero com Tailscale SSH;
#              ninguém dita nada: ela aparece como suporte-<host>-<xxxx>
#   upterm     sessão compartilhada via servidor upterm (token/QR code)
#
# USUÁRIO:  voidbr-suporte [tailscale|upterm]
# TÉCNICO:  voidbr-suporte lista | entrar <nome> [usuario] | ouvir
#

set -uo pipefail

red=$'\e[31m'
green=$'\e[32m'
yellow=$'\e[33m'
blue=$'\e[34m'
cyan=$'\e[36m'
bold=$'\e[1m'
reset=$'\e[0m'

conf=/etc/voidbr-suporte.conf
prog=${0##*/}

# ---- padrões (sobrescritos pelo $conf) ----------------------------------
modo="tailscale"
compartilhar=1
# 1 = abre o terminal compartilhado direto, sem pedir Enter (defina no $conf)
auto=0
# 1 = separadores powerline na barra do tmux (precisa de Nerd Font)
tmux_powerline=0
tmux_sessao="suporte"
# tailscale
ts_authkey=""
ts_tag="tag:suporte"
# upterm
tecnicos_github=""
tecnicos_chaves=/etc/voidbr-suporte/authorized_keys
servidor="ssh://uptermd.upterm.dev:22"
perguntar=0
# aviso ao técnico
ntfy_topico=""
ntfy_url="https://ntfy.sh"
# -------------------------------------------------------------------------

# shellcheck source=/dev/null
[[ -r $conf ]] && . "$conf"

msg()  { printf '%s==>%s %s%s%s\n' "$green$bold" "$reset" "$bold" "$*" "$reset"; }
info() { printf '%s  ->%s %s\n' "$blue$bold" "$reset" "$*"; }
warn() { printf '%s==> AVISO:%s %s\n' "$yellow$bold" "$reset" "$*"; }
die()  { printf '%s==> ERRO:%s %s\n' "$red$bold" "$reset" "$*" >&2; exit 1; }

need() {
	local c
	for c; do
		command -v "$c" >/dev/null || die "'$c' não instalado"
	done
}

banner() {
	clear
	printf '%s╔══════════════════════════════════════════════════════╗%s\n' "$cyan$bold" "$reset"
	printf '%s║             SUPORTE REMOTO VOIDBR ATIVO              ║%s\n' "$cyan$bold" "$reset"
	printf '%s╚══════════════════════════════════════════════════════╝%s\n\n' "$cyan$bold" "$reset"
}

mostrar_qr() {
	command -v qrencode >/dev/null || return 0
	# no tty (TERM=linux) usa blocos por cor de fundo, que qualquer fonte exibe
	if [[ ${TERM:-} == linux ]]; then
		qrencode -t ANSI -m 1 "$1"
	else
		qrencode -t ANSIUTF8 -m 1 "$1"
	fi
}

avisar_tecnico() {
	[[ -n $ntfy_topico ]] || return 0
	command -v curl >/dev/null || { warn "curl não instalado; técnico não foi avisado"; return 0; }
	if curl -fsS -m 10 \
		-H "Title: Suporte VoidBR: $(hostname)" \
		-H "Tags: computer" \
		-d "$1" "$ntfy_url/$ntfy_topico" >/dev/null; then
		info "${green}técnico avisado automaticamente${reset}"
	else
		warn "não consegui avisar o técnico; passe o comando acima para ele"
	fi
}

# abre o shell do usuário: dentro do tmux (tela compartilhada) ou direto
# abrir_shell [nome] [ip] [usuario]  -> aparecem em blocos coloridos na barra
abrir_shell() {
	local nome=${1:-} ip=${2:-} usuario=${3:-$(id -un)}

	if ! (( compartilhar )); then
		"${SHELL:-/bin/bash}" -l
		return
	fi

	# paleta Tokyo Night
	local c_bg="#1a1b26" c_fg="#c0caf5" c_dim="#565f89" c_sel="#3b4261"
	local c_red="#f7768e" c_blue="#7aa2f7" c_purple="#bb9af7"
	local c_green="#9ece6a" c_yellow="#e0af68"

	# separadores estilo powerline (precisa de Nerd Font; não aparece no tty)
	local sep_l="" sep_r=""
	if (( tmux_powerline )); then
		sep_l=$'\xee\x82\xb0'   # U+E0B0
		sep_r=$'\xee\x82\xb2'   # U+E0B2
	fi

	local left right
	# esquerda: SUPORTE | usuário
	left="#[bg=$c_red,fg=$c_bg,bold] SUPORTE "
	left+="#[fg=$c_red,bg=$c_blue,nobold]$sep_l"
	left+="#[bg=$c_blue,fg=$c_bg,bold] $usuario "
	left+="#[fg=$c_blue,bg=$c_bg,nobold]$sep_l "

	# direita: nome | ip | exit
	right=""
	if [[ -n $nome ]]; then
		right+="#[fg=$c_purple,bg=$c_bg]$sep_r"
		right+="#[bg=$c_purple,fg=$c_bg,bold] $nome "
		right+="#[fg=$c_green,bg=$c_purple,nobold]$sep_r"
	else
		right+="#[fg=$c_green,bg=$c_bg]$sep_r"
	fi
	if [[ -n $ip ]]; then
		right+="#[bg=$c_green,fg=$c_bg,bold] $ip "
		right+="#[fg=$c_yellow,bg=$c_green,nobold]$sep_r"
	else
		right+="#[fg=$c_yellow,bg=$c_bg]$sep_r"
	fi
	right+="#[bg=$c_yellow,fg=$c_bg,bold] exit = encerrar "

	tmux kill-session -t "$tmux_sessao" 2>/dev/null
	tmux new-session -s "$tmux_sessao" \; \
		set-option status-style "bg=$c_bg,fg=$c_fg" \; \
		set-option status-justify left \; \
		set-option status-left "$left" \; \
		set-option status-right "$right" \; \
		set-option status-left-length 60 \; \
		set-option status-right-length 120 \; \
		set-window-option window-status-format "#[fg=$c_dim,bg=$c_bg] #I:#W " \; \
		set-window-option window-status-current-format "#[fg=$c_fg,bg=$c_sel,bold] #I:#W " \; \
		set-window-option window-status-separator ""
}

# =========================================================================
# modo tailscale
# =========================================================================
ts_dir=""
ts_sock=""
ts_pid=""

ts() { tailscale --socket="$ts_sock" "$@"; }

ts_limpar() {
	trap - EXIT INT TERM
	printf '\n'
	msg "Encerrando o suporte"
	if [[ -n $ts_pid ]] && kill -0 "$ts_pid" 2>/dev/null; then
		timeout 10 tailscale --socket="$ts_sock" logout >/dev/null 2>&1
		kill "$ts_pid" 2>/dev/null
		wait "$ts_pid" 2>/dev/null
		info "máquina removida da rede do técnico"
	fi
	(( compartilhar )) && tmux kill-session -t "$tmux_sessao" 2>/dev/null
	[[ -n $ts_dir ]] && rm -rf "$ts_dir"
}

ts_nome() {
	# formato: suporte-<usuario>-<host>-<xxxx>  (máx. 63 caracteres)
	# o usuário vai no nome para o técnico entrar sem precisar informá-lo
	local u h sufixo max
	u=$(id -un | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
	h=$(hostname | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-')
	sufixo=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 4)
	max=$(( 63 - 8 - ${#u} - 1 - 1 - 4 ))
	(( max < 1 )) && max=1
	printf 'suporte-%s-%s-%s' "${u:-x}" "${h:0:max}" "$sufixo"
}

cmd_tailscale() {
	need tailscale tailscaled
	(( compartilhar )) && need tmux
	if [[ -z $ts_authkey || $ts_authkey == tskey-client-XXXX* ]]; then
		printf '%s==> ERRO:%s ts_authkey não definido em %s\n' "$red$bold" "$reset" "$conf" >&2
		info "para PEDIR suporte (usuário): configure o ts_authkey" >&2
		info "para DAR suporte (técnico):   $prog lista | entrar" >&2
		exit 1
	fi

	ts_dir=$(mktemp -d /tmp/voidbr-suporte.XXXXXX)
	ts_sock=$ts_dir/tailscaled.sock
	trap ts_limpar EXIT
	trap 'exit 130' INT TERM

	local nome usuario
	nome=$(ts_nome)
	usuario=$(id -un)

	msg "Iniciando suporte remoto"
	info "subindo conexão (modo userspace, estado só em memória)"
	# daemon próprio: não mexe num tailscaled que já exista na máquina
	tailscaled \
		--tun=userspace-networking \
		--state=mem: \
		--statedir="$ts_dir" \
		--socket="$ts_sock" \
		--port=0 \
		>"$ts_dir/tailscaled.log" 2>&1 &
	ts_pid=$!

	local _
	for _ in {1..20}; do
		[[ -S $ts_sock ]] && break
		kill -0 "$ts_pid" 2>/dev/null || die "tailscaled não subiu; veja $ts_dir/tailscaled.log"
		sleep 0.5
	done
	[[ -S $ts_sock ]] || die "tailscaled não respondeu"

	info "entrando na rede do técnico como $nome"
	if ! timeout 60 tailscale --socket="$ts_sock" up \
		--auth-key="$ts_authkey" \
		--advertise-tags="$ts_tag" \
		--hostname="$nome" \
		--ssh \
		--accept-dns=false \
		--accept-routes=false; then
		die "não consegui conectar; confira a internet e a ts_authkey"
	fi

	local ip acesso
	ip=$(ts ip -4 2>/dev/null | head -n1)
	if (( compartilhar )); then
		acesso="voidbr-suporte entrar ${ip:-$nome}"
	else
		acesso="voidbr-suporte entrar ${ip:-$nome}"
	fi

	banner
	printf 'Nome desta máquina para o técnico:\n\n  %s%s%s  (%s)\n\n' \
		"$yellow$bold" "$nome" "$reset" "${ip:-sem IP}"
	printf 'O técnico acessa com:\n  %s\n\n' "$acesso"
	avisar_tecnico "$acesso"

	if (( compartilhar )); then
		printf 'O técnico verá e digitará neste terminal junto com você.\n'
		printf 'Para %sENCERRAR o suporte%s, digite: %sexit%s\n\n' "$bold" "$reset" "$red$bold" "$reset"
		if (( auto )); then
			sleep 2
		else
			read -rp "Pressione Enter para abrir o terminal compartilhado..."
		fi
		abrir_shell "$nome" "$ip" "$usuario"
	else
		printf 'O técnico usará um terminal próprio nesta máquina.\n'
		if (( auto )); then
			printf 'Para %sENCERRAR o suporte%s, pressione %sCtrl+C%s\n' "$bold" "$reset" "$red$bold" "$reset"
			while :; do sleep 3600; done
		else
			read -rp "Pressione Enter para ENCERRAR o suporte..."
		fi
	fi
	# ts_limpar roda no EXIT
}

# =========================================================================
# modo upterm
# =========================================================================

# monta o comando ssh da sessão atual (só funciona DENTRO da sessão)
ssh_da_sessao() {
	local linha id host porta
	linha=$(upterm session current 2>/dev/null |
		sed -n 's/^[[:space:]]*SSH Session:[[:space:]]*//p' | head -n1)
	if [[ -n $linha ]]; then
		printf '%s\n' "$linha"
		return 0
	fi
	id=$(upterm session current -o go-template='{{.SessionID}}' 2>/dev/null)
	host=$(upterm session current -o go-template='{{.Host}}' 2>/dev/null)
	[[ -n $id && -n $host ]] || return 1
	host=${host#*://}
	porta=${host##*:}
	host=${host%:*}
	if [[ $porta == 22 || $porta == "$host" ]]; then
		printf 'ssh %s@%s\n' "$id" "$host"
	else
		printf 'ssh -p %s %s@%s\n' "$porta" "$id" "$host"
	fi
}

# roda DENTRO da sessão upterm
cmd_upterm_dentro() {
	local ssh_cmd="" _
	for _ in 1 2 3 4 5; do
		ssh_cmd=$(ssh_da_sessao) && break
		sleep 1
	done

	banner
	if [[ -n $ssh_cmd ]]; then
		printf 'Passe para o técnico:\n\n  %s%s%s\n\n' "$yellow$bold" "$ssh_cmd" "$reset"
		mostrar_qr "$ssh_cmd"
		avisar_tecnico "$ssh_cmd"
	else
		warn "não consegui ler o comando de acesso; rode: upterm session current"
	fi

	printf '\nO técnico verá e digitará neste terminal junto com você.\n'
	printf 'Para %sENCERRAR o suporte%s, digite: %sexit%s\n\n' "$bold" "$reset" "$red$bold" "$reset"

	exec "${SHELL:-/bin/bash}" -l
}

cmd_upterm() {
	need upterm

	local -a args=(host --server "$servidor" --skip-host-key-check)
	local autorizados=0 u

	for u in $tecnicos_github; do
		args+=(--github-user "$u")
		autorizados=1
	done
	if [[ -n $tecnicos_chaves && -s $tecnicos_chaves ]]; then
		args+=(--authorized-keys "$tecnicos_chaves")
		autorizados=1
	fi
	(( autorizados )) || die "nenhum técnico configurado em $conf (tecnicos_github ou tecnicos_chaves)"
	(( perguntar )) || args+=(--accept)

	msg "Iniciando suporte remoto (upterm)"
	info "conectando em ${servidor#*://}..."
	exec upterm "${args[@]}" -- "$(readlink -f "$0")" _upterm_dentro
}

# =========================================================================
# lado do técnico
# =========================================================================
# linhas "IP NOME ESTADO..." das máquinas de suporte online
ts_suporte() {
	tailscale status 2>/dev/null | awk '$2 ~ /^suporte-/'
}

# extrai o usuário do nome: suporte-<usuario>-<host>-<xxxx>
usuario_do_nome() {
	local n=${1#suporte-}
	printf '%s' "${n%%-*}"
}

cmd_lista() {
	need tailscale
	local linhas
	linhas=$(ts_suporte)
	if [[ -z $linhas ]]; then
		info "nenhuma máquina de suporte online"
		return 0
	fi
	printf '%s%-16s %-13s %-40s %s%s\n' "$bold" "IP" "USUÁRIO" "NOME" "ESTADO" "$reset"
	local ip nome _ resto
	while read -r ip nome _ _ resto; do
		printf '%-16s %-12s %-40s %s\n' "$ip" "$(usuario_do_nome "$nome")" "$nome" "$resto"
	done <<< "$linhas"
}

# entrar [nome|parte-do-nome|IP] [usuario]
cmd_entrar() {
	need tailscale ssh
	local alvo=${1:-} usuario=${2:-} linhas achados qtd ip nome

	linhas=$(ts_suporte)
	[[ -n $linhas ]] || die "nenhuma máquina de suporte online"

	if [[ -z $alvo ]]; then
		achados=$linhas
	elif [[ $alvo =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
		achados=$(awk -v a="$alvo" '$1 == a' <<< "$linhas")
		# IP fora da lista: entra direto, mas aí o usuário precisa ser informado
		[[ -n $achados ]] || achados="$alvo -"
	else
		# nome exato, com ou sem o prefixo suporte-, ou parte do nome
		achados=$(awk -v a="$alvo" '$2 == a || $2 == "suporte-" a' <<< "$linhas")
		[[ -n $achados ]] || achados=$(awk -v a="$alvo" 'index($2, a)' <<< "$linhas")
	fi

	qtd=$(grep -c . <<< "$achados")
	case $qtd in
		0) die "nenhuma máquina de suporte corresponde a '$alvo'" ;;
		1) ;;
		*) cmd_lista; die "mais de uma máquina corresponde; informe o nome ou o IP" ;;
	esac

	read -r ip nome _ <<< "$achados"
	if [[ -z $usuario ]]; then
		[[ $nome != - ]] && usuario=$(usuario_do_nome "$nome")
		[[ -n $usuario ]] || die "não sei o usuário de $ip; use: $prog entrar $ip <usuario>"
	fi

	msg "Entrando em $usuario@${nome/#-/$ip} ($ip)"
	if (( compartilhar )); then
		# máquinas de suporte são efêmeras: a chave muda a cada atendimento e o
		# IP pode ser reaproveitado, então não guardamos em known_hosts.
		# A identidade já é garantida pela tailnet (WireGuard).
		ssh -t \
			-o StrictHostKeyChecking=no \
			-o UserKnownHostsFile=/dev/null \
			-o LogLevel=ERROR \
			-o ForwardX11=no \
			"$usuario@$ip" tmux -u attach -t "$tmux_sessao"
	else
		tailscale ssh "$usuario@$ip"
	fi
	falha_entrar $? "$usuario" "$ip"
}

# falha_entrar <rc> <usuario> <ip>  -> explica por que não entrou
falha_entrar() {
	local rc=$1 usuario=$2 ip=$3
	(( rc == 0 )) && return 0

	printf '%s==> ERRO:%s não consegui entrar como '"'"'%s'"'"' em %s (código %s)\n' \
		"$red$bold" "$reset" "$usuario" "$ip" "$rc" >&2
	if (( rc == 255 )); then
		info "a conexão ou o login foi recusado" >&2
	else
		info "entrou, mas a sessão '$tmux_sessao' do tmux não abriu (no sessions?)" >&2
	fi
	info "o remoto pode estar com versão antiga do voidbr-suporte, ou o usuário é outro" >&2
	info "tente: $prog entrar $ip <usuario>" >&2
	exit "$rc"
}

cmd_ouvir() {
	[[ -n $ntfy_topico ]] || die "defina ntfy_topico em $conf"
	need curl
	msg "Aguardando chamados em $ntfy_url/$ntfy_topico (Ctrl+C para sair)"
	curl -fsSN "$ntfy_url/$ntfy_topico/raw" | while IFS= read -r linha; do
		[[ -n $linha ]] || continue
		printf '\n%s[%s] novo chamado:%s\n  %s\n' "$green$bold" "$(date +%H:%M:%S)" "$reset" "$linha"
	done
}

usage() {
	cat <<-EOF
	${bold}uso:${reset} $prog [comando]

	${bold}Usuário:${reset}
	  ${green}(nada)${reset}                    inicia o suporte no modo padrão ($modo)
	  ${green}tailscale${reset}                 inicia pelo Tailscale
	  ${green}upterm${reset}                    inicia pelo upterm

	${bold}Técnico:${reset}
	  ${green}lista${reset}                     máquinas de suporte online (tailscale)
	  ${green}entrar${reset} [nome|IP] [usuario] entra na máquina (usuário vem do nome)
	  ${green}ouvir${reset}                     aguarda chamados via ntfy

	Configuração: $conf
	EOF
}

case ${1:-} in
	"")              case $modo in
	                     tailscale) cmd_tailscale ;;
	                     upterm)    cmd_upterm ;;
	                     *)         die "modo inválido em $conf: $modo" ;;
	                 esac ;;
	tailscale)       cmd_tailscale ;;
	upterm)          cmd_upterm ;;
	_upterm_dentro)  cmd_upterm_dentro ;;
	lista|ls)        cmd_lista ;;
	entrar)          shift; cmd_entrar "$@" ;;
	ouvir)           cmd_ouvir ;;
	ajuda|-h|--help) usage ;;
	*)               usage; exit 1 ;;
esac

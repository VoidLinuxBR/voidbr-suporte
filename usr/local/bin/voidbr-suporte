#  voidbr-suporte - suporte remoto rápido estilo tmate
#
#  Dois modos (escolha em /etc/voidbr-suporte.conf ou na linha de comando):
#    tailscale  máquina entra na tailnet do técnico como nó efêmero com
#               Tailscale SSH; ninguém dita nada: ela aparece como
#               suporte-<usuario>-<host>-<xxxx>
#    upterm     sessão compartilhada via servidor upterm (token/QR code)
#
#  USUÁRIO:  voidbr-suporte [-t|--tailscale | -u|--upterm]
#  TÉCNICO:  voidbr-suporte -l|--list | -c|--connect [alvo] [usuario] | -n|--listen
##############################################################################
export LANGUAGE="${LANGUAGE:-pt_BR}"
export TEXTDOMAINDIR=/usr/share/locale
export TEXTDOMAIN=voidbr-suporte

#debug
export PS4='${red}${0##*/}${green}[$FUNCNAME]${pink}[$LINENO]${reset}'
#set -x
#set -e
#set -euo pipefail
shopt -s extglob

#system
declare APP="${0##*/}"
declare _VERSION_="0.09.28-20260928"

set -uo pipefail

red=$'\e[31m'
green=$'\e[32m'
yellow=$'\e[33m'
blue=$'\e[34m'
cyan=$'\e[36m'
pink=$'\e[35m'
bold=$'\e[1m'
reset=$'\e[0m'

# sh_col <texto> <largura>  -> texto alinhado por caracteres (não por bytes)
sh_col() {
	local t=$1 w=$2
	printf '%s%*s' "$t" $(( w > ${#t} ? w - ${#t} : 0 )) ''
}

conf=/etc/voidbr-suporte.conf

# ---- padrões (sobrescritos pelo $conf) ----------------------------------
modo="tailscale"
compartilhar=1
# 1 = abre o terminal compartilhado direto, sem pedir Enter (defina no $conf)
auto=0
# 1 = separadores powerline na barra do tmux (precisa de Nerd Font)
tmux_powerline=0
tmux_sessao="suporte"
# tailscale
ts_authkey=""
ts_tag="tag:suporte"
# upterm
tecnicos_github=""
tecnicos_chaves=/etc/voidbr-suporte/authorized_keys
servidor="ssh://uptermd.upterm.dev:22"
perguntar=0
# aviso ao técnico
ntfy_topico=""
ntfy_url="https://ntfy.sh"
# -------------------------------------------------------------------------

# shellcheck source=/dev/null
[[ -r $conf ]] && . "$conf"

sh_msg()  { printf '%s==>%s %s%s%s\n' "$green$bold" "$reset" "$bold" "$*" "$reset"; }
sh_info() { printf '%s  ->%s %s\n' "$blue$bold" "$reset" "$*"; }
sh_warn() { printf '%s==> %s%s %s\n' "$yellow$bold" "$(gettext "AVISO:")" "$reset" "$*"; }
sh_erro() { printf '%s==> %s%s %s\n' "$red$bold" "$(gettext "ERRO:")" "$reset" "$*" >&2; }
sh_die()  { sh_erro "$@"; exit 1; }

sh_need() {
	local c
	for c; do
		command -v "$c" >/dev/null || sh_die "$(printf "$(gettext "'%s' não instalado")" "$c")"
	done
}

sh_banner() {
	clear
	printf '%s╔══════════════════════════════════════════════════════╗%s\n' "$cyan$bold" "$reset"
	local t pad
	t=$(gettext "SUPORTE REMOTO VOIDBR ATIVO")
	pad=$(( (54 - ${#t}) / 2 ))
	(( pad < 0 )) && pad=0
	printf '%s║%*s%s%*s║%s\n' "$cyan$bold" "$pad" '' "$t" $(( 54 - pad - ${#t} > 0 ? 54 - pad - ${#t} : 0 )) '' "$reset"
	printf '%s╚══════════════════════════════════════════════════════╝%s\n\n' "$cyan$bold" "$reset"
}

sh_mostrar_qr() {
	command -v qrencode >/dev/null || return 0
	# no tty (TERM=linux) usa blocos por cor de fundo, que qualquer fonte exibe
	if [[ ${TERM:-} == linux ]]; then
		qrencode -t ANSI -m 1 "$1"
	else
		qrencode -t ANSIUTF8 -m 1 "$1"
	fi
}

sh_avisar_tecnico() {
	[[ -n $ntfy_topico ]] || return 0
	command -v curl >/dev/null || { sh_warn "$(gettext "curl não instalado; técnico não foi avisado")"; return 0; }
	if curl -fsS -m 10 \
		-H "Title: $(printf "$(gettext "Suporte VoidBR: %s")" "$(hostname)")" \
		-H "Tags: computer" \
		-d "$1" "$ntfy_url/$ntfy_topico" >/dev/null; then
		sh_info "${green}$(gettext "técnico avisado automaticamente")${reset}"
	else
		sh_warn "$(gettext "não consegui avisar o técnico; passe o comando acima para ele")"
	fi
}

# abre o shell do usuário: dentro do tmux (tela compartilhada) ou direto
# sh_abrir_shell [nome] [ip] [usuario]  -> aparecem em blocos coloridos na barra
sh_abrir_shell() {
	local nome=${1:-} ip=${2:-} usuario=${3:-$(id -un)}

	if ! (( compartilhar )); then
		"${SHELL:-/bin/bash}" -l
		return
	fi

	# paleta Tokyo Night
	local c_bg="#1a1b26" c_fg="#c0caf5" c_dim="#565f89" c_sel="#3b4261"
	local c_red="#f7768e" c_blue="#7aa2f7" c_purple="#bb9af7"
	local c_green="#9ece6a" c_yellow="#e0af68"

	# separadores estilo powerline (precisa de Nerd Font; não aparece no tty)
	local sep_l="" sep_r=""
	if (( tmux_powerline )); then
		sep_l=$'\xee\x82\xb0'   # U+E0B0
		sep_r=$'\xee\x82\xb2'   # U+E0B2
	fi

	local left right
	# esquerda: SUPORTE | usuário
	left="#[bg=$c_red,fg=$c_bg,bold] $(gettext "SUPORTE") "
	left+="#[fg=$c_red,bg=$c_blue,nobold]$sep_l"
	left+="#[bg=$c_blue,fg=$c_bg,bold] $usuario "
	left+="#[fg=$c_blue,bg=$c_bg,nobold]$sep_l "

	# direita: nome | ip | exit
	right=""
	if [[ -n $nome ]]; then
		right+="#[fg=$c_purple,bg=$c_bg]$sep_r"
		right+="#[bg=$c_purple,fg=$c_bg,bold] $nome "
		right+="#[fg=$c_green,bg=$c_purple,nobold]$sep_r"
	else
		right+="#[fg=$c_green,bg=$c_bg]$sep_r"
	fi
	if [[ -n $ip ]]; then
		right+="#[bg=$c_green,fg=$c_bg,bold] $ip "
		right+="#[fg=$c_yellow,bg=$c_green,nobold]$sep_r"
	else
		right+="#[fg=$c_yellow,bg=$c_bg]$sep_r"
	fi
	right+="#[bg=$c_yellow,fg=$c_bg,bold] $(gettext "exit = encerrar") "

	tmux kill-session -t "$tmux_sessao" 2>/dev/null
	tmux new-session -s "$tmux_sessao" \; \
		set-option status-style "bg=$c_bg,fg=$c_fg" \; \
		set-option status-justify left \; \
		set-option status-left "$left" \; \
		set-option status-right "$right" \; \
		set-option status-left-length 60 \; \
		set-option status-right-length 120 \; \
		set-window-option window-status-format "#[fg=$c_dim,bg=$c_bg] #I:#W " \; \
		set-window-option window-status-current-format "#[fg=$c_fg,bg=$c_sel,bold] #I:#W " \; \
		set-window-option window-status-separator ""
}

# =========================================================================
# modo tailscale
# =========================================================================
ts_dir=""
ts_sock=""
ts_pid=""

sh_ts() { tailscale --socket="$ts_sock" "$@"; }

sh_ts_limpar() {
	trap - EXIT INT TERM
	printf '\n'
	sh_msg "$(gettext "Encerrando o suporte")"
	if [[ -n $ts_pid ]] && kill -0 "$ts_pid" 2>/dev/null; then
		timeout 10 tailscale --socket="$ts_sock" logout >/dev/null 2>&1
		kill "$ts_pid" 2>/dev/null
		wait "$ts_pid" 2>/dev/null
		sh_info "$(gettext "máquina removida da rede do técnico")"
	fi
	(( compartilhar )) && tmux kill-session -t "$tmux_sessao" 2>/dev/null
	[[ -n $ts_dir ]] && rm -rf "$ts_dir"
}

sh_ts_nome() {
	# formato: suporte-<usuario>-<host>-<xxxx>  (máx. 63 caracteres)
	# o usuário vai no nome para o técnico entrar sem precisar informá-lo
	local u h sufixo max
	u=$(id -un | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
	h=$(hostname | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-')
	sufixo=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 4)
	max=$(( 63 - 8 - ${#u} - 1 - 1 - 4 ))
	(( max < 1 )) && max=1
	printf 'suporte-%s-%s-%s' "${u:-x}" "${h:0:max}" "$sufixo"
}

sh_tailscale() {
	sh_need tailscale tailscaled
	(( compartilhar )) && sh_need tmux
	if [[ -z $ts_authkey || $ts_authkey == tskey-client-XXXX* ]]; then
		sh_erro "$(printf "$(gettext "ts_authkey não definido em %s")" "$conf")"
		sh_info "$(gettext "para PEDIR suporte (usuário): configure o ts_authkey")" >&2
		sh_info "$(printf "$(gettext "para DAR suporte (técnico):   %s --list | --connect")" "$APP")" >&2
		exit 1
	fi

	ts_dir=$(mktemp -d /tmp/voidbr-suporte.XXXXXX)
	ts_sock=$ts_dir/tailscaled.sock
	trap sh_ts_limpar EXIT
	trap 'exit 130' INT TERM

	local nome usuario
	nome=$(sh_ts_nome)
	usuario=$(id -un)

	sh_msg "$(gettext "Iniciando suporte remoto")"
	sh_info "$(gettext "subindo conexão (modo userspace, estado só em memória)")"
	# daemon próprio: não mexe num tailscaled que já exista na máquina
	tailscaled \
		--tun=userspace-networking \
		--state=mem: \
		--statedir="$ts_dir" \
		--socket="$ts_sock" \
		--port=0 \
		>"$ts_dir/tailscaled.log" 2>&1 &
	ts_pid=$!

	local i
	for i in {1..20}; do
		[[ -S $ts_sock ]] && break
		kill -0 "$ts_pid" 2>/dev/null || sh_die "$(printf "$(gettext "tailscaled não subiu; veja %s")" "$ts_dir/tailscaled.log")"
		sleep 0.5
	done
	[[ -S $ts_sock ]] || sh_die "$(gettext "tailscaled não respondeu")"

	sh_info "$(printf "$(gettext "entrando na rede do técnico como %s")" "$nome")"
	if ! timeout 60 tailscale --socket="$ts_sock" up \
		--auth-key="$ts_authkey" \
		--advertise-tags="$ts_tag" \
		--hostname="$nome" \
		--ssh \
		--accept-risk=lose-ssh \
		--accept-dns=false \
		--accept-routes=false; then
		sh_die "$(gettext "não consegui conectar; confira a internet e a ts_authkey")"
	fi

	local ip acesso
	ip=$(sh_ts ip -4 2>/dev/null | head -n1)
	if (( compartilhar )); then
		acesso="voidbr-suporte --connect ${ip:-$nome}"
	else
		acesso="voidbr-suporte --connect ${ip:-$nome}"
	fi

	sh_banner
	printf '%s\n\n  %s%s%s  (%s)\n\n' "$(gettext "Nome desta máquina para o técnico:")" \
		"$yellow$bold" "$nome" "$reset" "${ip:-$(gettext "sem IP")}"
	printf '%s\n  %s\n\n' "$(gettext "O técnico acessa com:")" "$acesso"
	sh_avisar_tecnico "$acesso"

	if (( compartilhar )); then
		printf '%s\n' "$(gettext "O técnico verá e digitará neste terminal junto com você.")"
		printf '%s\n\n' "$(printf "$(gettext "Para %sENCERRAR o suporte%s, digite: %sexit%s")" "$bold" "$reset" "$red$bold" "$reset")"
		if (( auto )); then
			sleep 2
		else
			read -rp "$(gettext "Pressione Enter para abrir o terminal compartilhado...")"
		fi
		sh_abrir_shell "$nome" "$ip" "$usuario"
	else
		printf '%s\n' "$(gettext "O técnico usará um terminal próprio nesta máquina.")"
		if (( auto )); then
			printf '%s\n' "$(printf "$(gettext "Para %sENCERRAR o suporte%s, pressione %sCtrl+C%s")" "$bold" "$reset" "$red$bold" "$reset")"
			while :; do sleep 3600; done
		else
			read -rp "$(gettext "Pressione Enter para ENCERRAR o suporte...")"
		fi
	fi
	# sh_ts_limpar roda no EXIT
}

# =========================================================================
# modo upterm
# =========================================================================

# monta o comando ssh da sessão atual (só funciona DENTRO da sessão)
sh_ssh_da_sessao() {
	local linha id host porta
	linha=$(upterm session current 2>/dev/null |
		sed -n 's/^[[:space:]]*SSH Session:[[:space:]]*//p' | head -n1)
	if [[ -n $linha ]]; then
		printf '%s\n' "$linha"
		return 0
	fi
	id=$(upterm session current -o go-template='{{.SessionID}}' 2>/dev/null)
	host=$(upterm session current -o go-template='{{.Host}}' 2>/dev/null)
	[[ -n $id && -n $host ]] || return 1
	host=${host#*://}
	porta=${host##*:}
	host=${host%:*}
	if [[ $porta == 22 || $porta == "$host" ]]; then
		printf 'ssh %s@%s\n' "$id" "$host"
	else
		printf 'ssh -p %s %s@%s\n' "$porta" "$id" "$host"
	fi
}

# roda DENTRO da sessão upterm
sh_upterm_dentro() {
	local ssh_cmd="" i
	for i in 1 2 3 4 5; do
		ssh_cmd=$(sh_ssh_da_sessao) && break
		sleep 1
	done

	sh_banner
	if [[ -n $ssh_cmd ]]; then
		printf '%s\n\n  %s%s%s\n\n' "$(gettext "Passe para o técnico:")" "$yellow$bold" "$ssh_cmd" "$reset"
		sh_mostrar_qr "$ssh_cmd"
		sh_avisar_tecnico "$ssh_cmd"
	else
		sh_warn "$(printf "$(gettext "não consegui ler o comando de acesso; rode: %s")" "upterm session current")"
	fi

	printf '\n%s\n' "$(gettext "O técnico verá e digitará neste terminal junto com você.")"
	printf '%s\n\n' "$(printf "$(gettext "Para %sENCERRAR o suporte%s, digite: %sexit%s")" "$bold" "$reset" "$red$bold" "$reset")"

	exec "${SHELL:-/bin/bash}" -l
}

sh_upterm() {
	sh_need upterm

	local -a args=(host --server "$servidor" --skip-host-key-check)
	local autorizados=0 u

	for u in $tecnicos_github; do
		args+=(--github-user "$u")
		autorizados=1
	done
	if [[ -n $tecnicos_chaves && -s $tecnicos_chaves ]]; then
		args+=(--authorized-keys "$tecnicos_chaves")
		autorizados=1
	fi
	(( autorizados )) || sh_die "$(printf "$(gettext "nenhum técnico configurado em %s (tecnicos_github ou tecnicos_chaves)")" "$conf")"
	(( perguntar )) || args+=(--accept)

	sh_msg "$(gettext "Iniciando suporte remoto (upterm)")"
	sh_info "$(printf "$(gettext "conectando em %s...")" "${servidor#*://}")"
	exec upterm "${args[@]}" -- "$(readlink -f "$0")" _upterm_dentro
}

# =========================================================================
# lado do técnico
# =========================================================================
# linhas "IP NOME ESTADO..." das máquinas de suporte online
sh_ts_suporte() {
	tailscale status 2>/dev/null | awk '$2 ~ /^suporte-/'
}

# extrai o usuário do nome: suporte-<usuario>-<host>-<xxxx>
sh_usuario_do_nome() {
	local n=${1#suporte-}
	printf '%s' "${n%%-*}"
}

sh_list() {
	sh_need tailscale
	local linhas
	linhas=$(sh_ts_suporte)
	if [[ -z $linhas ]]; then
		sh_info "$(gettext "nenhuma máquina de suporte online")"
		return 0
	fi
	printf '%s%s %s %s %s%s\n' "$bold" "$(sh_col "$(gettext "IP")" 16)" "$(sh_col "$(gettext "USUÁRIO")" 12)" \
		"$(sh_col "$(gettext "NOME")" 40)" "$(gettext "ESTADO")" "$reset"
	local ip nome x resto
	while read -r ip nome x x resto; do
		printf '%-16s %-12s %-40s %s\n' "$ip" "$(sh_usuario_do_nome "$nome")" "$nome" "$resto"
	done <<< "$linhas"
}

# sh_connect [nome|parte-do-nome|IP] [usuario]
sh_connect() {
	sh_need tailscale ssh
	local alvo=${1:-} usuario=${2:-} linhas achados qtd ip nome x

	linhas=$(sh_ts_suporte)
	[[ -n $linhas ]] || sh_die "$(gettext "nenhuma máquina de suporte online")"

	if [[ -z $alvo ]]; then
		achados=$linhas
	elif [[ $alvo =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
		achados=$(awk -v a="$alvo" '$1 == a' <<< "$linhas")
		# IP fora da lista: entra direto, mas aí o usuário precisa ser informado
		[[ -n $achados ]] || achados="$alvo -"
	else
		# nome exato, com ou sem o prefixo suporte-, ou parte do nome
		achados=$(awk -v a="$alvo" '$2 == a || $2 == "suporte-" a' <<< "$linhas")
		[[ -n $achados ]] || achados=$(awk -v a="$alvo" 'index($2, a)' <<< "$linhas")
	fi

	qtd=$(grep -c . <<< "$achados")
	case $qtd in
		0) sh_die "$(printf "$(gettext "nenhuma máquina de suporte corresponde a '%s'")" "$alvo")" ;;
		1) ;;
		*) sh_list; sh_die "$(gettext "mais de uma máquina corresponde; informe o nome ou o IP")" ;;
	esac

	read -r ip nome x <<< "$achados"
	if [[ -z $usuario ]]; then
		[[ $nome != - ]] && usuario=$(sh_usuario_do_nome "$nome")
		[[ -n $usuario ]] || sh_die "$(printf "$(gettext "não sei o usuário de %s; use: %s --connect %s <usuario>")" "$ip" "$APP" "$ip")"
	fi

	sh_msg "$(printf "$(gettext "Entrando em %s (%s)")" "$usuario@${nome/#-/$ip}" "$ip")"
	if (( compartilhar )); then
		# máquinas de suporte são efêmeras: a chave muda a cada atendimento e o
		# IP pode ser reaproveitado, então não guardamos em known_hosts.
		# A identidade já é garantida pela tailnet (WireGuard).
		ssh -t \
			-o StrictHostKeyChecking=no \
			-o UserKnownHostsFile=/dev/null \
			-o LogLevel=ERROR \
			-o ForwardX11=no \
			"$usuario@$ip" tmux -u attach -t "$tmux_sessao"
	else
		tailscale ssh "$usuario@$ip"
	fi
	sh_connect_failed $? "$usuario" "$ip"
}

# sh_connect_failed <rc> <usuario> <ip>  -> explica por que não entrou
sh_connect_failed() {
	local rc=$1 usuario=$2 ip=$3
	(( rc == 0 )) && return 0

	sh_erro "$(printf "$(gettext "não consegui entrar como '%s' em %s (código %s)")" "$usuario" "$ip" "$rc")"
	if (( rc == 255 )); then
		sh_info "$(gettext "a conexão ou o login foi recusado")" >&2
	else
		sh_info "$(printf "$(gettext "entrou, mas a sessão '%s' do tmux não abriu (no sessions?)")" "$tmux_sessao")" >&2
	fi
	sh_info "$(gettext "o remoto pode estar com versão antiga do voidbr-suporte, ou o usuário é outro")" >&2
	sh_info "$(printf "$(gettext "tente: %s --connect %s <usuario>")" "$APP" "$ip")" >&2
	exit "$rc"
}

sh_listen() {
	[[ -n $ntfy_topico ]] || sh_die "$(printf "$(gettext "defina ntfy_topico em %s")" "$conf")"
	sh_need curl
	sh_msg "$(printf "$(gettext "Aguardando chamados em %s (Ctrl+C para sair)")" "$ntfy_url/$ntfy_topico")"
	curl -fsSN "$ntfy_url/$ntfy_topico/raw" | while IFS= read -r linha; do
		[[ -n $linha ]] || continue
		printf '\n%s[%s] %s%s\n  %s\n' "$green$bold" "$(date +%H:%M:%S)" "$(gettext "novo chamado:")" "$reset" "$linha"
	done
}

sh_usage() {
	local g=$green r=$reset b=$bold
	printf '%s%s%s %s %s\n\n' "$b" "$(gettext "uso:")" "$r" "$APP" "$(gettext "[opções]")"

	printf '%s%s%s\n' "$b" "$(gettext "Usuário (pedir suporte):")" "$r"
	printf '  %s%s%s %s\n' "$g" "$(sh_col "$(gettext "(sem opções)")" 31)" "$r" "$(printf "$(gettext "inicia o suporte (modo do .conf: %s)")" "$modo")"
	printf '  %s%s%s %s\n' "$g" "$(sh_col "-t, --tailscale" 31)" "$r" "$(gettext "força o modo Tailscale")"
	printf '  %s%s%s %s\n\n' "$g" "$(sh_col "-u, --upterm" 31)" "$r" "$(gettext "força o modo upterm")"

	printf '%s%s%s\n' "$b" "$(gettext "Técnico (dar suporte):")" "$r"
	printf '  %s%s%s %s\n' "$g" "$(sh_col "-l, --list" 31)" "$r" "$(gettext "máquinas aguardando suporte")"
	printf '  %s%s%s %s\n' "$g" "$(sh_col "-c, --connect $(gettext "[alvo] [usuario]")" 31)" "$r" "$(gettext "conecta na máquina (nome, parte do nome ou IP)")"
	printf '  %s%s%s %s\n\n' "$g" "$(sh_col "-n, --listen" 31)" "$r" "$(gettext "aguarda chamados via ntfy")"

	printf '%s%s%s\n' "$b" "$(gettext "Gerais:")" "$r"
	printf '  %s%s%s %s\n' "$g" "$(sh_col "-h, --help" 31)" "$r" "$(gettext "mostra esta ajuda")"
	printf '  %s%s%s %s\n\n' "$g" "$(sh_col "-V, --version" 31)" "$r" "$(gettext "mostra a versão")"

	printf '%s%s%s\n' "$b" "$(gettext "Exemplos:")" "$r"
	printf '  %s # %s\n' "$(sh_col "$APP" 33)" "$(gettext "usuário pede suporte")"
	printf '  %s # %s\n' "$(sh_col "$APP -l" 33)" "$(gettext "técnico vê quem está aguardando")"
	printf '  %s # %s\n' "$(sh_col "$APP -c" 33)" "$(gettext "conecta (se houver só uma máquina)")"
	printf '  %s # %s\n\n' "$(sh_col "$APP -c 100.95.244.100" 33)" "$(gettext "conecta pelo IP")"

	printf '%s %s\n' "$(gettext "Configuração:")" "$conf"
}

case ${1:-} in
	"")                    case $modo in
	                           tailscale) sh_tailscale ;;
	                           upterm)    sh_upterm ;;
	                           *)         sh_die "$(printf "$(gettext "modo inválido em %s: %s")" "$conf" "$modo")" ;;
	                       esac ;;
	-t|--tailscale)        sh_tailscale ;;
	-u|--upterm)           sh_upterm ;;
	-l|--list)             sh_list ;;
	-c|--connect)          shift; sh_connect "$@" ;;
	-n|--listen)           sh_listen ;;
	-h|--help)             sh_usage ;;
	-V|--version)          printf '%s %s\n' "$APP" "$_VERSION_" ;;
	_upterm_dentro)        sh_upterm_dentro ;;
	# compatibilidade com os comandos antigos (não aparecem na ajuda)
	tailscale)             sh_tailscale ;;
	upterm)                sh_upterm ;;
	lista|ls)              sh_list ;;
	entrar)                shift; sh_connect "$@" ;;
	ouvir)                 sh_listen ;;
	ajuda)                 sh_usage ;;
	*)                     sh_erro "$(printf "$(gettext "opção inválida: %s")" "$1")"; printf '\n' >&2
	                       sh_usage >&2; exit 1 ;;
esac
